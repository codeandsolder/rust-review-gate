 /// * `forwarded_notification`
 ///   is whether a [`Response::ArtifactNotification`] already reached `stderr`,
 ///   in which case its copy in compiler's stderr is dropped.
+fn needs_lto_jobserver(cmdline: &[OsString]) -> bool {
+    let mut uses_lto = false;
+    for arg in cmdline.iter().filter_map(|arg| arg.to_str()) {
+        if matches!(arg, "-c" | "-S" | "-E") {
+            return false;
+        }
+        if arg == "-fno-lto" {
+            uses_lto = false;
+        } else if arg == "-flto" || arg.starts_with("-flto=") {
+            uses_lto = true;
+        }
+    }
+    uses_lto
+}
