+    #[test]
+    #[cfg(unix)]
+    fn lto_link_fallback_inherits_jobserver_but_compile_only_does_not() {
+        use std::os::unix::fs::PermissionsExt;
+
+        let tempdir = tempfile::tempdir().unwrap();
+        let script = tempdir.path().join("jobserver-probe.sh");
+        std::fs::write(
+            &script,
+            r#"#!/bin/sh
+if [ -n "$CARGO_MAKEFLAGS" ]; then exit 0; else exit 42; fi
+"#,
+        )
+        .unwrap();
+        let mut permissions = std::fs::metadata(&script).unwrap().permissions();
+        permissions.set_mode(0o755);
+        std::fs::set_permissions(&script, permissions).unwrap();
+
+        let client = Client::new_num(1);
+        let creator = <ProcessCommandCreator as CommandCreatorSync>::new(&client);
+        let mut runtime = make_runtime();
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+
+        let link_code = handle_compile_result(
+            creator.clone(),
+            &mut runtime,
+            CompileResponse::UnhandledCompile,
+            None,
+            false,
+            &script,
+            vec![OsString::from("-flto")],
+            tempdir.path(),
+            &mut stdout,
+            &mut stderr,
+        )
+        .unwrap();
+        assert_eq!(
+            link_code, 0,
+            "LTO link fallback should inherit the jobserver"
+        );
+
+        let compile_only_code = handle_compile_result(
+            creator,
+            &mut runtime,
+            CompileResponse::UnhandledCompile,
+            None,
+            false,
+            &script,
+            vec![OsString::from("-flto"), OsString::from("-c")],
+            tempdir.path(),
+            &mut stdout,
+            &mut stderr,
+        )
+        .unwrap();
+        assert_eq!(
+            compile_only_code, 42,
+            "compile-only fallback should keep the jobserver private"
+        );
+    }
